<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#F4F4F4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- CABECERA DE CONEXIÓN -->
        <Button
            android:id="@+id/btnConectar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar a Cuarto de Servidores (Bluetooth)" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: Desconectado"
            android:textAlignment="center"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <!-- DASHBOARD AMBIENTAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:id="@+id/tvTemp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- °C\nTemp"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#D32F2F"/>
                
            <TextView
                android:id="@+id/tvHum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="-- %\nHumedad"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textAlignment="center"
                android:textColor="#1976D2"/>
        </LinearLayout>

        <!-- GRÁFICA TÉRMICA (MPAndroidChart) -->
        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/graficoTemperatura"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginBottom="24dp"
            android:background="#FFFFFF"
            android:elevation="4dp"/>

        <!-- PANEL OT: EMERGENCIA Y SEGURIDAD -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PANEL DE CONTROL OT"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnEmergencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ABRIR PUERTA (EMERGENCIA)"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnLockdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVAR LOCKDOWN (BLOQUEO TECLADO)"
            android:backgroundTint="#212121"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="8dp"/>
            
        <Button
            android:id="@+id/btnDesbloquear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESBLOQUEAR SISTEMA"
            android:layout_marginBottom="16dp"/>

        <!-- PANEL DE ADMINISTRACIÓN DINÁMICA -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">
            <EditText
                android:id="@+id/etNuevoUmbral"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Umbral Ej: 35.5"
                android:inputType="numberDecimal"/>
            <Button
                android:id="@+id/btnSetUmbral"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fijar Umbral"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etNuevaClave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Nuevo PIN"
                android:inputType="numberPassword"/>
            <Button
                android:id="@+id/btnSetClave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cambiar PIN"/>
        </LinearLayout>

        <!-- CONSOLA DE REGISTROS -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Consola de Eventos:"
            android:textStyle="bold"/>
            
        <TextView
            android:id="@+id/tvConsola"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:background="#000000"
            android:textColor="#00FF00"
            android:padding="8dp"
            android:scrollbars="vertical"
            android:typeface="monospace"/>

    </LinearLayout>
</ScrollView>
